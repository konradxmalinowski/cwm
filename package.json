{
  "name": "cwm",
  "version": "0.2.0",
  "private": true,
  "description": "Desktop manager for AI tool configuration: skills, agents, commands, rules.",
  "license": "MIT",
  "main": "dist/main/index.js",
  "bin": {
    "cwm": "dist/cli/index.js"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build:main": "tsc -p tsconfig.main.json && node scripts/copy-schema.mjs",
    "build:preload": "node scripts/build-preload.mjs",
    "build:renderer": "ng build",
    "build": "npm run build:main && npm run build:preload && npm run build:renderer",
    "dev": "node scripts/dev.mjs",
    "rebuild:native": "electron-builder install-app-deps",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.preload.json --noEmit && tsc -p tsconfig.tests.json --noEmit",
    "test": "vitest run",
    "notices": "node scripts/third-party-notices.mjs",
    "test:boundaries": "node scripts/verify-boundaries.mjs",
    "test:e2e": "playwright test",
    "package": "electron-builder --dir",
    "package:dist": "electron-builder"
  },
  "dependencies": {
    "@clack/prompts": "1.9.0",
    "better-sqlite3": "13.1.1",
    "commander": "15.1.0",
    "smol-toml": "1.9.1",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@angular/build": "20.3.40",
    "@angular/cli": "20.3.40",
    "@angular/common": "20.3.34",
    "@angular/compiler": "20.3.34",
    "@angular/compiler-cli": "20.3.34",
    "@angular/core": "20.3.34",
    "@angular/platform-browser": "20.3.34",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.0",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "26.6.6",
    "axe-core": "4.14.0",
    "electron": "45.3.2",
    "electron-builder": "26.18.0",
    "esbuild": "0.28.2",
    "eslint": "10.14.0",
    "eslint-plugin-import-x": "4.18.1",
    "fast-check": "4.10.2",
    "globals": "17.14.0",
    "prettier": "3.10.1",
    "rxjs": "7.8.2",
    "tslib": "2.9.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.2",
    "vitest": "5.1.0"
  },
  "overrides": {
    "@angular/build": {
      "vitest": "5.0.5"
    }
  }
}
